#!/bin/zsh
# Creates a new key-variant of a song: transposes its .cho file and (by
# default) registers it in song-catalog.csv. The output filename/SONG ID is
# derived automatically from the naming convention - never overwrites an
# existing file, and never overwrites the source.
#
# Usage:
#   ./transpose <SONG_ID> --offset <N> [--no-import]
#
#   ./transpose ABC:B:BobSeger:HollywoodNights --offset 5
#   ./transpose ABC:B:BobSeger:HollywoodNights-b --offset -2 --no-import

"${0:a:h}/cpt" transpose "$@"
