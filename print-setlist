#!/bin/zsh
# Write a floor setlist — large-type portrait sheets, one "A01-45 Song Title" row per song — as HTML.
# Open it in a browser, print it, and tape it down.
#
# Usage:
#   ./print-setlist                                        # latest gig → ./work/setlist.html (git-ignored)
#   ./print-setlist --gig 2026-06-14-rusty-nail            # specific gig
#   ./print-setlist --gig 2026-06-14-rusty-nail --output ./gig-2026-06-14.html

"${0:a:h}/cpt" print-setlist "$@"
