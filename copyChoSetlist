#!/usr/bin/env zsh

rm -rf ./work/setlist-ff
mkdir -p ./work/setlist-ff

# \cp bypasses any `cp -i` alias, -f forces overwrite w/o prompting,
# and </dev/null guarantees we never silently block waiting on stdin
# if some other confirmation prompt sneaks in (e.g. cloud-sync tooling).
# Destination is project-local + gitignored (see ./work) rather than
# ~/tmp, since a repo checkout living under an iCloud/OneDrive-synced
# folder can stall on cloud placeholder files regardless of where the
# copy lands - keeping scratch output local avoids compounding that.
for file in **/*.cho(.); do \cp -f "$file" ./work/setlist-ff/ < /dev/null; done

