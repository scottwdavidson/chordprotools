#!/bin/zsh
# Check that key-variants of a song share consistent catalog metadata.
# Everything must match except KEY and CAPO (the per-variant levers); the
# performance key MUST match. Also flags filename/key mismatches.
#
# Dry-run by default. Exits non-zero if any issues are found.
#
# Usage:
#   ./consistent-metadata                  # report only, whole catalog
#   ./consistent-metadata --fix            # fix drift from base variants, EVERY group
#   ./consistent-metadata --fix --only ABC:B:BobSeger:HollywoodNights    # just that one group
#   ./consistent-metadata --fix --only ABC:B:BobSeger:HollywoodNights \
#                         --source ABC:B:BobSeger:HollywoodNights-b      # ...with -b as the source

"${0:a:h}/cpt" consistent-metadata "$@"
